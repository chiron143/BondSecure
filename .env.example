# Copy to .env.local and fill in. Never commit .env.local.
# Get a key at https://aistudio.google.com (API keys). Without it, the app runs in demo mode.
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-3.8-flash
# Optional: ABN Lookup web services GUID (free) for finding the operator's legal name.
# Register at https://abr.business.gov.au/Tools/WebServicesAgreement. Without it, the app links to the public search.
ABR_GUID=
# Optional: models to try when the main one is overloaded (comma-separated)
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
